{
  "manifest_version": 3,
  "name": "Crypto Fees",
  "version": "1.1",
  "description": "Fee di rete in tempo reale per Bitcoin (sat/vB) ed Ethereum (Gwei).",
  "host_permissions": [
    "https://mempool.space/*",
    "https://ethereum-rpc.publicnode.com/*",
    "https://eth.llamarpc.com/*"
  ],
  "permissions": ["storage"],
  "action": {
    "default_title": "Crypto Fees",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}
